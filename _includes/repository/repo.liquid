{% assign repo_url = include.repository | split: "/" %}

<a
  class="repo-card is-loading"
  data-repo="{{ include.repository }}"
  href="https://github.com/{{ include.repository }}"
  target="_blank"
  rel="noopener noreferrer"
  aria-label="{{ include.repository }} on GitHub"
>
  <span class="repo-card-accent" aria-hidden="true"></span>

  <div class="repo-card-head">
    <span class="repo-card-owner">
      <i class="fa-brands fa-github repo-card-owner-icon" aria-hidden="true"></i>
      <span class="repo-card-owner-name">{{ repo_url[0] }}</span>
    </span>
    <span class="repo-card-badge">Public</span>
  </div>

  <h3 class="repo-card-name">{{ repo_url[1] }}</h3>

  <p class="repo-card-desc">
    <span class="repo-skel repo-skel-line"></span>
    <span class="repo-skel repo-skel-line is-short"></span>
  </p>

  <div class="repo-card-meta">
    <span class="repo-card-lang" hidden>
      <span class="repo-card-lang-dot"></span>
      <span class="repo-card-lang-name"></span>
    </span>
    <span class="repo-card-stat repo-card-stars" title="Stars">
      <i class="fa-solid fa-star" aria-hidden="true"></i>
      <span class="repo-card-stars-count">—</span>
    </span>
    <span class="repo-card-stat repo-card-forks" title="Forks">
      <i class="fa-solid fa-code-fork" aria-hidden="true"></i>
      <span class="repo-card-forks-count">—</span>
    </span>
  </div>
</a>
